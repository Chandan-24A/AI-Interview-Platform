PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/interview_prep
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# OpenRouter AI API
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Email Service (Resend recommended for cloud deployments like Render)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM=AI Interview Platform <onboarding@resend.dev>

# Alternative: Nodemailer SMTP (for local development)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
